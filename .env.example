DISCORD_TOKEN=
DISCORD_CHANNEL_ID=

GITHUB_ACCESS_TOKEN=
GITHUB_USERNAME=
GITHUB_REPOSITORY=

# Where the webhook endpoint listens. Defaults to 127.0.0.1:5000, which is
# what a reverse proxy or an SSH tunnel on the same machine reaches. Set
# HOST=0.0.0.0 only if the endpoint has to be reachable from another machine.
HOST=
PORT=

# Recommended: shared secret configured on the GitHub webhook. Requests with
# a missing/invalid X-Hub-Signature-256 will be rejected with 401. Leave blank
# to disable verification (NOT recommended for public deployments).
GITHUB_WEBHOOK_SECRET=

# Tag <-> issue-state mapping lives in src/tagMapping.config.json, not in env.

# Durable closed-post reminder/countdown state. Keep this file across deploys.
# Defaults to data/completed-threads.json relative to the working directory.
# Use a persistent volume when running in a container. One bot instance per file.
COMPLETED_THREADS_STATE_FILE=

# Durable server-scoped knowledge entries. Keep this file across deploys.
# Defaults to data/knowledge-base.json. One bot instance per file.
KNOWLEDGE_BASE_FILE=
